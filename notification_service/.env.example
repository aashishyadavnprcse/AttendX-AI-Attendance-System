# ==============================================================================
# AttendX Notification Microservice Environment Configuration
# ==============================================================================

# Database Connection (Same DB as AttendX FastAPI backend)
DATABASE_URL="sqlite:///./attendx.db"
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/attendx"

# Scheduler Configuration (Daily after class hours)
DAILY_CRON_HOUR=17          # 5:00 PM
DAILY_CRON_MINUTE=0         # 17:00
CONSECUTIVE_ABSENCE_DAYS=3  # Trigger threshold

# Provider Selection: "twilio" or "meta"
WHATSAPP_PROVIDER="twilio"

# ------------------------------------------------------------------------------
# Option A: Twilio WhatsApp API Credentials
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"  # Twilio Sandbox or Approved Sender

# ------------------------------------------------------------------------------
# Option B: Meta WhatsApp Cloud API (Graph API)
# ------------------------------------------------------------------------------
META_WHATSAPP_TOKEN="EAAG..."
META_PHONE_NUMBER_ID="109283746501928"
META_TEMPLATE_NAME="attendx_consecutive_absence_alert"
