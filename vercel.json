{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/health",
      "dest": "/public_landing.html",
      "status": 200
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard-preview.html"
    },
    {
      "src": "/app",
      "dest": "/dashboard-preview.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/",
      "dest": "/public_landing.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=*, geolocation=*, microphone=*"
        }
      ]
    }
  ]
}
