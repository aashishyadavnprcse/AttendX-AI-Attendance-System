# AttendX Environment Configuration
PROJECT_NAME="AttendX AI Smart Attendance Backend"
API_V1_STR="/api"
SECRET_KEY="attendx_super_secret_jwt_key_replace_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL / SQLite fallback)
# For local Postgres: postgresql+psycopg2://postgres:postgres@localhost:5432/attendx
# For instant zero-config testing: sqlite:///./attendx.db
DATABASE_URL="sqlite:///./attendx.db"

# AI Face Biometrics
FACE_MATCH_SIMILARITY_THRESHOLD=0.75
LIVENESS_MIN_CONFIDENCE=0.85
