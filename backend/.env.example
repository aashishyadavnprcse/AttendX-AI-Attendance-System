# ==============================================================================
# AttendX AI Environment Configuration Template
# For local development: copy to .env (do not commit .env to version control)
# ==============================================================================

# Application Environment Mode: 'development' | 'production'
ENVIRONMENT="development"
PROJECT_NAME="AttendX AI Smart Attendance Backend"
API_V1_STR="/api"

# Cryptographic Security
# IN PRODUCTION: MUST be set to a cryptographically strong random string (min 32 characters).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
# In development mode, a safe local fallback is provided if left blank.
SECRET_KEY="your-cryptographic-secret-key-min-32-chars-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins
# Comma-separated list of permitted frontend origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Production Deployed Frontend Domain (Leave empty in local dev, set in production)
# Example: https://attendx.yourinstitution.edu
PRODUCTION_FRONTEND_URL=""

# Database Configuration (PostgreSQL / SQLite fallback)
# For production hosted deployments: postgresql+psycopg2://user:password@host:5432/attendx
# For local development: sqlite:///./attendx.db
DATABASE_URL="sqlite:///./attendx.db"

# AI Face Biometrics & Anti-Spoofing Thresholds
FACE_MATCH_SIMILARITY_THRESHOLD=0.75
LIVENESS_MIN_CONFIDENCE=0.85
