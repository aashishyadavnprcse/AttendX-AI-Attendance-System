# ==============================================================================
# AttendX AI Production Environment Configuration Template
# Copy this file to .env in your production environment and configure variables.
# NEVER commit the real .env file or production secrets to Git.
# ==============================================================================

# Application Metadata
PROJECT_NAME="AttendX AI Smart Attendance Backend"
API_V1_STR="/api"
ENVIRONMENT="production"

# Cryptographic Security
# Generate a secure 32+ byte key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Production Database (PostgreSQL Recommended for Hosted Deployments)
# SQLite is suitable for single-node local servers with persistent disk volumes.
# For serverless / containerized deployments (AWS ECS, Render, Railway, Fly.io, Kubernetes),
# use a managed PostgreSQL instance (Neon, Supabase, AWS RDS, Cloud SQL):
# DATABASE_URL="postgresql+psycopg2://<user>:<password>@<db-host>:5432/<dbname>"
DATABASE_URL="sqlite:///./attendx.db"

# CORS Configuration
# Restrict allowed origins to your production frontend domain (e.g. https://attendx.edu)
ALLOWED_ORIGINS="https://attendx.yourdomain.com,http://localhost:3000"

# AI Face Biometrics & Anti-Spoofing Thresholds
# Standard recommended thresholds for production security:
FACE_MATCH_SIMILARITY_THRESHOLD=0.75
LIVENESS_MIN_CONFIDENCE=0.85
GEOFENCE_DEFAULT_RADIUS_METERS=20.0

# Optional Carrier SMS Gateway (Leave blank for transparent PREVIEW_MODE)
# TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_FROM_NUMBER="+1234567890"

# Optional Fast2SMS Gateway (India)
# FAST2SMS_API_KEY="your_fast2sms_api_key"

# Optional SMTP Email Relay
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="notifications@attendx.ai"
# SMTP_PASSWORD="your_app_password"
